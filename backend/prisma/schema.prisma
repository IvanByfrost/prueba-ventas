generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model vendedor {
  vendedorId     String  @id @default(uuid())
  nombreVendedor String
  comision       Float
  ventas         venta[]

  @@map("vendedores")
}

model producto {
  productoId     String  @id @default(uuid())
  nombreProducto String
  valorUnitario  Float
  ventas         venta[]

  @@map("productos")
}

model venta {
  ventaId    String   @id @default(uuid())
  vendedorId String
  productoId String
  valorTotal Float
  
  vendedor   vendedor @relation(fields: [vendedorId], references: [vendedorId], onDelete: Cascade)
  producto   producto @relation(fields: [productoId], references: [productoId], onDelete: Cascade)

  @@map("ventas")
}